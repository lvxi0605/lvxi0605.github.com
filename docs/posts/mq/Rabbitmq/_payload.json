[{"data":1,"prerenderedAt":75},["ShallowReactive",2],{"post:\u002Fposts\u002Fmq\u002FRabbitmq":3,"surround:\u002Fposts\u002Fmq\u002FRabbitmq":68},{"id":4,"title":5,"body":6,"categories":49,"comment":51,"createdAt":52,"description":44,"extension":53,"meta":54,"navigation":51,"path":55,"readingTime":56,"recommend":51,"seo":57,"stem":58,"tags":59,"top":62,"topics":63,"updatedAt":65,"words":66,"__hash__":67},"posts\u002Fposts\u002Fmq\u002FRabbitmq.md","RabbitMQ简介",{"type":7,"value":8,"toc":43},"minimark",[9,13,17,24,31,37],[10,11,12],"h2",{"id":12},"介绍",[14,15,16],"p",{},"RabbitMQ是一个消息中间件，用来接受和转发消息。你可以把它想象成一个邮局:当你把你想要寄的邮件放在一个邮筒里时，你可以肯定邮递员最终会把邮件送到收件人那里。在这个类比中，RabbitMQ是一个邮筒、一个邮局和一个邮递员。",[14,18,19,23],{},[20,21,22],"strong",{},"生产者","(product)：发送消息的程序",[14,25,26],{},[27,28],"img",{"alt":29,"src":30},"image-20221202101605869","\u002Fpostimg\u002Fimage-20221202101605869.png",[14,32,33,36],{},[20,34,35],{},"队列","(queue)：接收生产者发送的消息，消息流经队列，存储在内存或者磁盘中，并转发给对应的消费者。本质上是一个大型的消息缓冲区。多个生产者可以向一个队列发送消息，一个队里可以将消息转发给一个或多个消费者。",[14,38,39],{},[27,40],{"alt":41,"src":42},"image-20221202102535824","\u002Fpostimg\u002Fimage-20221202102535824.png",{"title":44,"searchDepth":45,"depth":46,"links":47},"",2,3,[48],{"id":12,"depth":45,"text":12},[50],"设计模式",true,"2024-03-14","md",{},"\u002Fposts\u002Fmq\u002FRabbitmq",59100,{"title":5,"description":44},"posts\u002Fmq\u002FRabbitmq",[60,61],"单一职责","开闭原则",false,[64],"mq",null,197,"xUwmeKsclhgYxabvv7GeyPxfaToxG5EllKMNApkjHlw",{"prev":69,"next":72},{"path":70,"title":71},"\u002Fposts\u002Fmisc\u002Fpodcast-playlist-4","我的播客与歌单管理（四）",{"path":73,"title":74},"\u002Fposts\u002Fmq\u002Fmq-backlog","消息积压的应急与根治",1794073361015]